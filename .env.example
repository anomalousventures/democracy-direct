# Database
# Production: Use Neon or other hosted Postgres
DATABASE_URL=postgresql://user:password@host:5432/database

# Local development: Use docker-compose postgres
# DATABASE_URL=postgresql://democracy:democracy@localhost:5432/democracy_direct

# Email Provider: "smtp" | "ses"
# smtp: Use SMTP server (Mailpit for local dev, or production SMTP)
# ses: Use AWS SES (production)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@democracy-direct.com

# SMTP Configuration (for EMAIL_PROVIDER=smtp)
# Local dev with Mailpit: docker-compose up -d mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# AWS SES Configuration (for EMAIL_PROVIDER=ses)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Admin Users (comma-separated emails for admin access)
# These users will be created/updated as admins on deploy
ADMIN_USERS=

# Content Moderation (optional - for template submission)
OPENAI_API_KEY=

# Cloudflare Turnstile (for bot protection)
# Options for local development:
#   1. Use test-secret to disable turnstile: TURNSTILE_SECRET_KEY=test-secret
#   2. Use Cloudflare's testing keys (works on localhost):
#      TURNSTILE_SITE_KEY=1x00000000000000000000AA
#      TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=test-site-key
TURNSTILE_SECRET_KEY=test-secret

# Data Sources
CONGRESS_API_KEY=

# Analytics (optional)
PLAUSIBLE_DOMAIN=democracy-direct.com
