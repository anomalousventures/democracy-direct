# Database
# Production: Use Neon or other hosted Postgres
DATABASE_URL=postgresql://user:password@host:5432/database

# Local development: Use docker-compose postgres
# DATABASE_URL=postgresql://democracy:democracy@localhost:5432/democracy_direct

# Email Provider: "console" | "smtp" | "ses"
# console: Logs to terminal (local dev only, FAILS in production)
# smtp: Use SMTP server (Mailpit for local dev)
# ses: Use AWS SES (production)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@democracydirect.us

# SMTP Configuration (for EMAIL_PROVIDER=smtp)
# Local dev with Mailpit: docker-compose up -d mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# AWS SES Configuration (for EMAIL_PROVIDER=ses)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Content Moderation (optional - for template submission)
OPENAI_API_KEY=
PERSPECTIVE_API_KEY=

# Cloudflare Turnstile (for bot protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Data Sources
CONGRESS_API_KEY=

# Analytics (optional)
PLAUSIBLE_DOMAIN=democracy-direct.com
