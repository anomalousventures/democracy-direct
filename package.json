{
  "name": "democracy-direct",
  "type": "module",
  "version": "0.1.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "import:legislators": "npx tsx src/scripts/import-legislators.ts",
    "import:zips": "npx tsx src/scripts/import-zips.ts",
    "export:zips": "npx tsx src/scripts/export-zips.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.12",
    "@astrojs/react": "4.4.2",
    "@neondatabase/serverless": "1.0.2",
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "astro": "5.16.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.1",
    "lucide-react": "0.563.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.0.10",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.0.18",
    "drizzle-kit": "0.31.8",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-react": "7.37.5",
    "husky": "9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "16.2.7",
    "playwright": "1.58.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.21.0",
    "typescript-eslint": "8.54.0",
    "vitest": "4.0.18",
    "wrangler": "4.61.0",
    "yaml": "2.8.2"
  }
}
