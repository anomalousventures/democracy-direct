# Database (Neon serverless Postgres)
DATABASE_URL=postgresql://user:password@host:5432/database

# Email Provider: "smtp" | "ses"
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@democracy-direct.com

# SMTP Configuration (for local dev with Mailpit)
# Use 127.0.0.1 instead of localhost for WSL2 compatibility
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# AWS SES Configuration (for EMAIL_PROVIDER=ses in production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-1

# Admin Users (comma-separated email hashes for admin access)
# ADMIN_USERS=

# Content Moderation
# OPENAI_API_KEY=

# Cloudflare Turnstile (bot protection)
# Testing keys below always pass and work on localhost
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Data Sources
# CONGRESS_API_KEY=
