---
interface Props {
  width?: "narrow" | "medium" | "wide" | "xl";
  variant?: "content" | "default" | "cta";
  divider?: boolean;
  class?: string;
}

const { width = "medium", variant = "content", divider = false } = Astro.props;

const sectionClasses = {
  content: "section-content",
  default: "section-default",
  cta: "section-cta",
};
const containerClasses = {
  narrow: "container-narrow",
  medium: "container-medium",
  wide: "container-wide",
  xl: "container-xl",
};
---

{divider && <div class="divider-civic" />}
<section class:list={[sectionClasses[variant], Astro.props.class]}>
  {
    variant === "cta" && (
      <div class="cta-grid-pattern" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5" />
          </pattern>
          <rect width="100" height="100" fill="url(#grid)" />
        </svg>
      </div>
    )
  }
  <div class="container-page relative">
    <div class={containerClasses[width]}>
      <slot />
    </div>
  </div>
</section>
