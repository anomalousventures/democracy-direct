---
import { iconPaths, type IconName } from "./paths";

interface Props {
  name: IconName;
  class?: string;
  "aria-hidden"?: boolean | string;
}

const { name, class: className = "w-4 h-4", "aria-hidden": ariaHidden } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaHidden}
>
  <Fragment set:html={iconPaths[name]} />
</svg>
