---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AstroButton from "@/components/ui/AstroButton.astro";
import AstroCard from "@/components/ui/AstroCard.astro";
import Icon from "@/components/icons/Icon.astro";
import { ShareButtons } from "@/components/ShareButtons";
import { createDb } from "@/db/client";
import { getLegislatorByBioguideId } from "@/db/queries/legislators";
import { getVotesByMember, getVoteStats } from "@/db/queries/votes";
import { getBillsByMember, getBillCount } from "@/db/queries/bills";
import { templates } from "@/db/schema";
import { eq, and } from "drizzle-orm";
import { ContactFlow } from "@/components/ContactFlow";
import { RepTabs } from "@/components/RepTabs";
import type { Legislator } from "@/db/schema";
import type { VoteWithPosition, VoteStats } from "@/db/queries/votes";
import type { Bill } from "@/db/schema";
import {
  getPhotoUrl,
  getPartyColor,
  getPartyLabel,
  getRepTitle,
  formatDate,
} from "@/lib/legislator-utils";
import { sanitizeExternalUrl } from "@/lib/url";
import { BIOGUIDE_RE } from "@/lib/bioguide";
import { getConfig } from "@/lib/config";

const user = Astro.locals.user;

const { bioguideId } = Astro.params;
const rawTemplateSlug = Astro.url.searchParams.get("template");
const templateSlug =
  rawTemplateSlug && /^[a-z0-9-]{1,100}$/.test(rawTemplateSlug) ? rawTemplateSlug : null;

let rep: Legislator | null = null;
let error: string | null = null;
let templateContent: string | null = null;
let templateTitle: string | null = null;
let votes: VoteWithPosition[] = [];
let voteStats: VoteStats = { totalVotes: 0, yeas: 0, nays: 0, notVoting: 0, present: 0 };
let bills: Bill[] = [];
let billCount = 0;

const isInvalidId = !bioguideId || !BIOGUIDE_RE.test(bioguideId);
if (isInvalidId) {
  error = "Invalid representative ID.";
}

if (!error) {
  const config = getConfig(Astro.locals);
  const db = createDb(config.database.url);
  const [loadedRep, dbError] = await getLegislatorByBioguideId(db, bioguideId!)
    .then((result) => [result, null] as const)
    .catch((e) => {
      console.error("Database error:", e);
      return [null, "Failed to load representative details."] as const;
    });

  rep = loadedRep;
  error = dbError;

  if (!error && !rep) {
    Astro.response.status = 404;
    error = "Representative not found.";
  }

  if (templateSlug && !error) {
    try {
      const [template] = await db
        .select({ body: templates.body, title: templates.title })
        .from(templates)
        .where(
          and(
            eq(templates.slug, templateSlug),
            eq(templates.isPublic, true),
            eq(templates.moderationStatus, "approved")
          )
        )
        .limit(1);

      if (template) {
        templateContent = template.body;
        templateTitle = template.title;
      }
    } catch (e) {
      console.error("Failed to load template:", e);
    }
  }

  if (rep && !error) {
    try {
      const [loadedVotes, loadedStats, loadedBills, loadedBillCount] = await Promise.all([
        getVotesByMember(db, bioguideId!, { limit: 50 }),
        getVoteStats(db, bioguideId!),
        getBillsByMember(db, bioguideId!, { limit: 50 }),
        getBillCount(db, { bioguideId: bioguideId! }),
      ]);
      votes = loadedVotes;
      voteStats = loadedStats;
      bills = loadedBills;
      billCount = loadedBillCount;
    } catch (e) {
      console.error("Failed to load voting/bill data:", e);
    }
  }
}

const sanitizedContactUrl = rep ? sanitizeExternalUrl(rep.contactFormUrl) : null;
---

<Layout
  title={rep
    ? `${rep.chamber === "senate" ? "Sen." : "Rep."} ${rep.firstName} ${rep.lastName} (${getPartyLabel(rep.party, true)}-${rep.state})`
    : "Representative Not Found"}
  description={rep
    ? `Contact information for ${rep.chamber === "senate" ? "Sen." : "Rep."} ${rep.firstName} ${rep.lastName}, representing ${rep.state}${rep.chamber === "house" && rep.district !== "0" ? `-${rep.district}` : ""}`
    : "Representative not found"}
  ogImage={rep
    ? `https://theunitedstates.io/images/congress/450x550/${rep.bioguideId}.jpg`
    : undefined}
>
  <Header currentPath={`/rep/${bioguideId}`} user={user} />

  <main id="main-content" class="flex-1 py-12">
    <div class="container-page">
      {
        error ? (
          <div class="container-narrow text-center">
            <AstroCard variant="civicLg">
              <div class="icon-box-lg mx-auto mb-6">
                <Icon name="triangle-alert" class="w-8 h-8 text-destructive" />
              </div>
              <h1 class="heading-card-lg">{error}</h1>
              <p class="text-muted-foreground mb-8">
                The representative you're looking for couldn't be found.
              </p>
              <AstroButton href="/" variant="civic">
                Find Your Representatives
              </AstroButton>
            </AstroCard>
          </div>
        ) : (
          rep && (
            <div class="container-wide">
              <AstroCard variant="civicLg" class="animate-fade-up no-print block">
                <div class="flex flex-col sm:flex-row gap-6">
                  <div class="flex-shrink-0">
                    <div class="rep-photo-lg">
                      <img
                        src={getPhotoUrl(rep.bioguideId)}
                        alt={`${rep.firstName} ${rep.lastName}`}
                        class="w-full h-full object-cover object-top relative z-10"
                        onerror="this.style.display='none'"
                      />
                      <div class="rep-photo-fallback-lg" style="font-family: var(--font-display)">
                        {rep.firstName[0]}
                        {rep.lastName[0]}
                      </div>
                    </div>
                  </div>

                  <div class="flex-1 flex flex-col justify-center">
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
                      <h1 class="text-3xl sm:text-4xl font-bold">
                        {rep.firstName} {rep.lastName}
                      </h1>
                      <span class={`${getPartyColor(rep.party)} party-badge-lg`}>
                        {getPartyLabel(rep.party)}
                      </span>
                    </div>
                    <p class="text-lg text-muted-foreground mb-4">
                      {getRepTitle(rep.chamber, rep.state, rep.district)}
                    </p>

                    {rep.termStart && (
                      <p class="text-sm text-muted-foreground mb-4">
                        <span class="font-medium">Current Term:</span> {formatDate(rep.termStart)}
                        {rep.termEnd && ` — ${formatDate(rep.termEnd)}`}
                      </p>
                    )}

                    <div>
                      <ShareButtons
                        client:load
                        url={Astro.url.href}
                        title={`${rep.chamber === "senate" ? "Sen." : "Rep."} ${rep.firstName} ${rep.lastName}`}
                        description={`Contact ${rep.chamber === "senate" ? "Sen." : "Rep."} ${rep.firstName} ${rep.lastName} (${rep.party}-${rep.state}) about issues that matter to you.`}
                        pageType="rep"
                        repInfo={{
                          name: `${rep.firstName} ${rep.lastName}`,
                          party: rep.party,
                          state: rep.state,
                        }}
                      />
                    </div>
                  </div>
                </div>

                <div class="pt-6">
                  <RepTabs
                    client:load
                    chamber={rep.chamber as "house" | "senate"}
                    contactInfo={{
                      phone: rep.phoneCapitol || undefined,
                      contactFormUrl: sanitizedContactUrl || undefined,
                      address: rep.addressCapitol || undefined,
                      website: rep.website
                        ? (sanitizeExternalUrl(rep.website) ?? undefined)
                        : undefined,
                      twitterHandle: rep.twitterHandle || undefined,
                      facebookId: rep.facebookId || undefined,
                    }}
                    votes={votes}
                    voteStats={voteStats}
                    bills={bills}
                    billCount={billCount}
                  />
                </div>
              </AstroCard>

              <div class="mt-8 animate-fade-up-delay-1">
                <ContactFlow
                  client:load
                  representative={{
                    first_name: rep.firstName,
                    last_name: rep.lastName,
                    party: rep.party,
                    state: rep.state,
                    district: rep.district,
                    chamber: rep.chamber as "senate" | "house",
                    contact_form: sanitizedContactUrl || undefined,
                    phone: rep.phoneCapitol || undefined,
                    office_address: rep.addressCapitol || undefined,
                  }}
                  initialTemplate={templateContent || undefined}
                  templateName={templateTitle || undefined}
                  templateSlug={templateSlug || undefined}
                  repBioguideId={bioguideId}
                />
              </div>

              <div class="text-center mt-12 no-print">
                <a href="/" class="link-back">
                  <Icon name="chevron-left" class="w-4 h-4" />
                  <span>Look up a different ZIP code</span>
                </a>
              </div>
            </div>
          )
        )
      }
    </div>
  </main>

  <Footer currentPath={`/rep/${bioguideId}`} />
</Layout>
