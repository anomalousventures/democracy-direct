---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { MapWithTooltip } from "@/components/MapWithTooltip";

const user = Astro.locals.user;

const latParam = Astro.url.searchParams.get("lat");
const lngParam = Astro.url.searchParams.get("lng");
const zoomParam = Astro.url.searchParams.get("zoom");
const stateParam = Astro.url.searchParams.get("state");
const districtParam = Astro.url.searchParams.get("district");

const initialView =
  latParam && lngParam
    ? {
        lat: parseFloat(latParam),
        lng: parseFloat(lngParam),
        zoom: zoomParam ? parseInt(zoomParam, 10) : 11,
      }
    : undefined;

const highlightDistrict =
  stateParam && districtParam
    ? { state: stateParam.toUpperCase(), district: districtParam }
    : undefined;
---

<Layout
  title="District Map"
  description="Find your congressional district and representative on an interactive map"
>
  <link slot="head" rel="preconnect" href="https://tiles.openfreemap.org" />
  <link slot="head" rel="preconnect" href="https://tigerweb.geo.census.gov" />

  <Header currentPath="/map" user={user} />

  <main id="main-content" class="flex-1 flex flex-col">
    <div class="border-b border-border bg-white px-4 py-3">
      <div class="container mx-auto">
        <h1 class="text-lg font-semibold text-primary tracking-tight">
          Congressional District Map
        </h1>
        <p class="text-xs text-muted-foreground mt-0.5">
          Click any district to view your representative
        </p>
      </div>
    </div>

    <div class="map-area flex-1 relative min-h-[400px]">
      <div class="absolute inset-0 z-0 bg-muted/20 flex items-center justify-center">
        <div class="flex flex-col items-center gap-4">
          <div
            class="w-16 h-16 rounded-full border-2 border-border flex items-center justify-center"
          >
            <svg
              class="w-8 h-8 text-muted-foreground/40 animate-pulse"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
              ></path>
            </svg>
          </div>
          <p class="text-sm text-muted-foreground/60 tracking-wide">Loading district map&hellip;</p>
        </div>
      </div>
      <MapWithTooltip
        client:only="react"
        initialView={initialView}
        highlightDistrict={highlightDistrict}
      />
    </div>

    <div class="border-t border-border bg-white/80 px-4 py-2">
      <p class="text-[11px] text-muted-foreground text-center">
        Map tiles by <a
          href="https://openfreemap.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-primary transition-colors">OpenFreeMap</a
        > &amp; <a
          href="https://www.openstreetmap.org/copyright"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-primary transition-colors">OpenStreetMap</a
        >. District boundaries from <a
          href="https://tigerweb.geo.census.gov/"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-primary transition-colors">U.S. Census Bureau</a
        >.
      </p>
    </div>
  </main>

  <Footer currentPath="/map" />
</Layout>
