---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { createDb } from "../../db/client";
import { getLegislatorsByStateAndDistrict } from "../../db/queries/legislators";
import type { Legislator } from "../../db/schema";
import zipData from "../../../public/data/zip-districts.json";
import { getPhotoUrl, getPartyColor, getPartyLabel, getRepTitle } from "../../lib/legislator-utils";

interface ClientZipEntry {
  s: string;
  d: { d: string; p: number }[];
}

const { zip } = Astro.params;
const district = Astro.url.searchParams.get("district");

let reps: Legislator[] = [];
let zipInfo: { state: string; district: string } | null = null;
let error: string | null = null;

const isInvalidZip = !zip || !/^\d{5}$/.test(zip);
if (isInvalidZip) {
  error = "Invalid ZIP code format.";
}

const zipEntry = !isInvalidZip ? (zipData as Record<string, ClientZipEntry>)[zip] : null;
if (!error && !zipEntry) {
  error = "ZIP code not found in our database.";
}

const hasAmbiguousDistrict = zipEntry && zipEntry.d.length > 1 && !district;
if (hasAmbiguousDistrict) {
  return Astro.redirect(`/?ambiguous=${zip}`);
}

if (!error && zipEntry) {
  const selectedDistrict = district || zipEntry.d[0].d;
  const selectedState = zipEntry.s;
  zipInfo = { state: selectedState, district: selectedDistrict };

  const db = createDb(import.meta.env.DATABASE_URL);
  const [loadedReps, dbError] = await getLegislatorsByStateAndDistrict(
    db,
    selectedState,
    selectedDistrict
  )
    .then((result) => [result, null] as const)
    .catch((e) => {
      console.error("Database error:", e);
      return [[] as Legislator[], "Failed to look up representatives. Please try again."] as const;
    });

  reps = loadedReps;
  error = dbError;
}
---

<Layout
  title={zipInfo ? `Representatives for ${zip}` : "ZIP Lookup"}
  description={zipInfo
    ? `Find your senators and representative for ZIP code ${zip}`
    : "Look up your congressional representatives"}
>
  <header class="border-b border-border bg-white/80 backdrop-blur-sm sticky top-0 z-50">
    <div class="container mx-auto px-4 py-4">
      <nav class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 bg-[var(--color-civic-navy)] flex items-center justify-center">
            <span
              class="text-[var(--color-civic-gold)] text-xl font-bold"
              style="font-family: var(--font-display)">D</span
            >
          </div>
          <span class="font-semibold text-[var(--color-civic-navy)] hidden sm:inline"
            >Democracy Direct</span
          >
        </a>
        <div class="flex items-center gap-6">
          <a
            href="/about"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            About
          </a>
          <a
            href="/templates"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            Templates
          </a>
        </div>
      </nav>
    </div>
  </header>

  <main class="flex-1 py-12">
    <div class="container mx-auto px-4">
      {
        error ? (
          <div class="max-w-2xl mx-auto text-center">
            <div class="card-civic">
              <div class="w-16 h-16 mx-auto mb-6 bg-[var(--color-civic-red)]/10 flex items-center justify-center">
                <svg
                  class="w-8 h-8 text-[var(--color-civic-red)]"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  />
                </svg>
              </div>
              <h1 class="text-2xl font-bold mb-4">{error}</h1>
              <p class="text-muted-foreground mb-8">Please check the ZIP code and try again.</p>
              <a href="/" class="btn-primary inline-block">
                Try Again
              </a>
            </div>
          </div>
        ) : (
          <>
            <div class="max-w-4xl mx-auto">
              <div class="text-center mb-12 animate-fade-up">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-secondary)] border border-[var(--color-border)] text-sm text-[var(--color-muted-foreground)] mb-6">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  <span>ZIP Code {zip}</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-bold mb-4">Your Representatives</h1>
                <p class="text-muted-foreground">
                  {zipInfo?.state}{" "}
                  {zipInfo?.district !== "0" ? `District ${zipInfo?.district}` : "At-Large"}
                </p>
              </div>

              <div class="grid gap-6">
                {reps.map((rep, index) => (
                  <article
                    class="card-civic group hover:-translate-y-1 transition-transform duration-300 animate-fade-up"
                    style={`animation-delay: ${index * 100}ms`}
                  >
                    <div class="flex flex-col sm:flex-row gap-6">
                      <div class="flex-shrink-0">
                        <div class="relative w-32 h-40 mx-auto sm:mx-0 bg-[var(--color-secondary)] overflow-hidden">
                          <img
                            src={getPhotoUrl(rep.bioguideId)}
                            alt={`${rep.firstName} ${rep.lastName}`}
                            class="w-full h-full object-cover object-top"
                            loading="lazy"
                            onerror="this.style.display='none'"
                          />
                          <div
                            class="absolute inset-0 flex items-center justify-center text-4xl font-bold text-[var(--color-muted-foreground)]/30"
                            style="font-family: var(--font-display)"
                          >
                            {rep.firstName[0]}
                            {rep.lastName[0]}
                          </div>
                        </div>
                      </div>

                      <div class="flex-1">
                        <div class="flex items-start justify-between gap-4 mb-2">
                          <div>
                            <h2 class="text-xl sm:text-2xl font-bold">
                              <a
                                href={`/rep/${rep.bioguideId}`}
                                class="hover:text-[var(--color-civic-gold)] transition-colors"
                              >
                                {rep.firstName} {rep.lastName}
                              </a>
                            </h2>
                            <p class="text-muted-foreground">
                              {getRepTitle(rep.chamber, rep.state, rep.district, "short")}
                            </p>
                          </div>
                          <span
                            class={`${getPartyColor(rep.party)} text-white px-3 py-1 text-sm font-semibold`}
                          >
                            {getPartyLabel(rep.party, true)}
                          </span>
                        </div>

                        <div class="flex flex-wrap gap-3 mt-4">
                          {rep.phoneCapitol && (
                            <a
                              href={`tel:${rep.phoneCapitol}`}
                              class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-secondary)] hover:bg-[var(--color-muted)] border border-[var(--color-border)] text-sm transition-colors"
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                />
                              </svg>
                              <span>{rep.phoneCapitol}</span>
                            </a>
                          )}

                          {rep.contactFormUrl && (
                            <a
                              href={rep.contactFormUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-civic-navy)] text-[var(--color-civic-cream)] text-sm font-medium transition-colors hover:bg-[var(--color-civic-navy)]/90"
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                />
                              </svg>
                              <span>Contact Form</span>
                              <svg
                                class="w-3 h-3"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                />
                              </svg>
                            </a>
                          )}

                          <a
                            href={`/rep/${rep.bioguideId}`}
                            class="inline-flex items-center gap-2 px-4 py-2 border border-[var(--color-civic-navy)] text-[var(--color-civic-navy)] text-sm font-medium transition-colors hover:bg-[var(--color-civic-navy)] hover:text-[var(--color-civic-cream)]"
                          >
                            <span>Full Profile</span>
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"
                              />
                            </svg>
                          </a>
                        </div>
                      </div>
                    </div>
                  </article>
                ))}
              </div>

              <div class="text-center mt-12">
                <a
                  href="/"
                  class="inline-flex items-center gap-2 text-[var(--color-muted-foreground)] hover:text-[var(--color-civic-navy)] transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 19l-7-7 7-7"
                    />
                  </svg>
                  <span>Look up a different ZIP code</span>
                </a>
              </div>
            </div>
          </>
        )
      }
    </div>
  </main>

  <footer class="border-t border-border py-8 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <span class="text-muted-foreground text-sm">
          © {new Date().getFullYear()} Democracy Direct
        </span>
        <nav class="flex items-center gap-6">
          <a
            href="/about"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            About
          </a>
          <a
            href="/privacy"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            Privacy
          </a>
        </nav>
      </div>
    </div>
  </footer>
</Layout>
