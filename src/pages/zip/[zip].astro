---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AstroButton from "@/components/ui/AstroButton.astro";
import AstroCard from "@/components/ui/AstroCard.astro";
import { SaveDistrictPrompt } from "@/components/SaveDistrictPrompt";
import { createDb } from "@/db/client";
import { getLegislatorsByStateAndDistrict } from "@/db/queries/legislators";
import type { Legislator } from "@/db/schema";
import zipData from "../../../public/data/zip-districts.json";
import { getPhotoUrl, getPartyColor, getPartyLabel, getRepTitle } from "@/lib/legislator-utils";
import { sanitizeExternalUrl } from "@/lib/url";
import { getConfig } from "@/lib/config";
import { getStateName } from "@/lib/states";

const user = Astro.locals.user;

interface ClientZipEntry {
  s: string;
  d: { d: string; p: number }[];
}

const { zip } = Astro.params;
const district = Astro.url.searchParams.get("district");
const rawTemplateSlug = Astro.url.searchParams.get("template");
const templateSlug =
  rawTemplateSlug && /^[a-z0-9-]{1,100}$/.test(rawTemplateSlug) ? rawTemplateSlug : null;
const templateQueryParam = templateSlug ? `?template=${encodeURIComponent(templateSlug)}` : "";

let reps: Legislator[] = [];
let zipInfo: { state: string; district: string } | null = null;
let error: string | null = null;

const isInvalidZip = !zip || !/^\d{5}$/.test(zip);
if (isInvalidZip) {
  error = "Invalid ZIP code format.";
}

const zipEntry = !isInvalidZip ? (zipData as Record<string, ClientZipEntry>)[zip] : null;
if (!error && !zipEntry) {
  error =
    "We don't have district data for this ZIP code. This may be a PO Box, military, or very new ZIP.";
}

const hasMultipleDistricts = zipEntry && zipEntry.d.length > 1 && !district;
if (hasMultipleDistricts) {
  const params = new URLSearchParams({ ambiguous: zip });
  if (templateSlug) params.set("template", templateSlug);
  return Astro.redirect(`/?${params.toString()}`);
}

if (!error && zipEntry) {
  const selectedDistrict = district || zipEntry.d[0].d;
  const selectedState = zipEntry.s;
  zipInfo = { state: selectedState, district: selectedDistrict };

  const config = getConfig(Astro.locals);
  const db = createDb(config.database.url);
  const [loadedReps, dbError] = await getLegislatorsByStateAndDistrict(
    db,
    selectedState,
    selectedDistrict
  )
    .then((result) => [result, null] as const)
    .catch((e) => {
      console.error("Database error:", e);
      return [[] as Legislator[], "Failed to look up representatives. Please try again."] as const;
    });

  reps = loadedReps.sort((a, b) => {
    if (a.chamber === "house" && b.chamber === "senate") return -1;
    if (a.chamber === "senate" && b.chamber === "house") return 1;
    return 0;
  });
  error = dbError;
}
---

<Layout
  title={zipInfo ? `Your Representatives for ${zip} | ${zipInfo.state}` : "ZIP Lookup"}
  description={zipInfo
    ? `Find and contact your ${reps.length} elected officials for ZIP code ${zip} in ${getStateName(zipInfo.state)}`
    : "Look up your congressional representatives by ZIP code"}
>
  <Header currentPath={`/zip/${zip}`} user={user} />

  <main id="main-content" class="flex-1 py-12">
    <div class="container-page">
      {
        error ? (
          <div class="container-narrow text-center">
            <AstroCard variant="civicLg">
              <div class="icon-box-lg mx-auto mb-6">
                <svg
                  class="w-8 h-8 text-destructive"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  />
                </svg>
              </div>
              <h1 class="heading-card-lg">{error}</h1>
              <p class="text-muted-foreground mb-8">Please check the ZIP code and try again.</p>
              <AstroButton href="/" variant="civic">
                Try Again
              </AstroButton>
            </AstroCard>
          </div>
        ) : (
          <>
            <div class="container-wide">
              <div class="text-center mb-8 animate-fade-up">
                <div class="hero-badge mb-6">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  <span>ZIP Code {zip}</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-bold mb-4">Your Representatives</h1>
                <p class="text-muted-foreground">
                  {zipInfo?.state}{" "}
                  {zipInfo?.district !== "0" ? `District ${zipInfo?.district}` : "At-Large"}
                </p>
              </div>

              {zipInfo && (
                <div class="mb-8 animate-fade-up" style="animation-delay: 50ms">
                  <SaveDistrictPrompt
                    client:load
                    state={zipInfo.state}
                    district={zipInfo.district}
                    isLoggedIn={!!user}
                  />
                </div>
              )}

              <div class="grid gap-6">
                {reps.map((rep, index) => (
                  <AstroCard
                    variant="civic"
                    class="animate-fade-up"
                    style={`animation-delay: ${index * 100}ms`}
                  >
                    <div class="flex flex-col sm:flex-row gap-6">
                      <div class="flex-shrink-0">
                        <div class="rep-photo-sm">
                          <img
                            src={getPhotoUrl(rep.bioguideId)}
                            alt={`${rep.firstName} ${rep.lastName}`}
                            class="w-full h-full object-cover object-top"
                            loading="lazy"
                            onerror="this.style.display='none'"
                          />
                          <div
                            class="rep-photo-fallback-sm"
                            style="font-family: var(--font-display)"
                          >
                            {rep.firstName[0]}
                            {rep.lastName[0]}
                          </div>
                        </div>
                      </div>

                      <div class="flex-1">
                        <div class="flex items-start justify-between gap-4 mb-2">
                          <div>
                            <h2 class="text-xl sm:text-2xl font-bold">
                              <a
                                href={`/rep/${rep.bioguideId}${templateQueryParam}`}
                                class="hover:text-accent transition-colors"
                              >
                                {rep.firstName} {rep.lastName}
                              </a>
                            </h2>
                            <p class="text-muted-foreground">
                              {getRepTitle(rep.chamber, rep.state, rep.district, "short")}
                            </p>
                          </div>
                          <span class={`${getPartyColor(rep.party)} party-badge`}>
                            {getPartyLabel(rep.party, true)}
                          </span>
                        </div>

                        <div class="flex flex-wrap gap-3 mt-4">
                          {rep.phoneCapitol && (
                            <AstroButton
                              href={`tel:${rep.phoneCapitol}`}
                              variant="contactSecondary"
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                />
                              </svg>
                              <span>{rep.phoneCapitol}</span>
                            </AstroButton>
                          )}

                          {sanitizeExternalUrl(rep.contactFormUrl) && (
                            <AstroButton
                              href={sanitizeExternalUrl(rep.contactFormUrl)!}
                              variant="contactPrimary"
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                />
                              </svg>
                              <span>Contact Form</span>
                              <svg
                                class="w-3 h-3"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                />
                              </svg>
                            </AstroButton>
                          )}

                          <AstroButton
                            href={`/rep/${rep.bioguideId}${templateQueryParam}`}
                            variant="contactOutline"
                          >
                            <span>Full Profile</span>
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"
                              />
                            </svg>
                          </AstroButton>
                        </div>
                      </div>
                    </div>
                  </AstroCard>
                ))}
              </div>

              <div class="text-center mt-12">
                <a href="/" class="link-back">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 19l-7-7 7-7"
                    />
                  </svg>
                  <span>Look up a different ZIP code</span>
                </a>
              </div>
            </div>
          </>
        )
      }
    </div>
  </main>

  <Footer currentPath={`/zip/${zip}`} />
</Layout>
