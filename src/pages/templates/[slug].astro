---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AstroButton from "@/components/ui/AstroButton.astro";
import AstroCard from "@/components/ui/AstroCard.astro";
import { ShareButtons } from "@/components/ShareButtons";
import { TemplateReportButton } from "@/components/TemplateReportButton";
import { TemplateUseButton } from "@/components/TemplateUseButton";
import { MarkdownContent } from "@/components/MarkdownContent";
import { createDb } from "@/db/client";
import { templates } from "@/db/schema";
import { eq, sql } from "drizzle-orm";
import { getConfig } from "@/lib/config";

const user = Astro.locals.user;
const { slug } = Astro.params;
const rawRepId = Astro.url.searchParams.get("rep");
const repBioguideId = rawRepId && /^[A-Z]{1,2}\d{5,6}$/.test(rawRepId) ? rawRepId : null;

let template: {
  id: string;
  slug: string;
  title: string;
  description: string | null;
  body: string;
  issueTags: string[] | null;
  linkedBillNumbers: string[] | null;
  isPublic: boolean;
  viewCount: number;
  useCount: number;
  userId: string | null;
  forkedFrom: string | null;
  createdAt: Date;
} | null = null;

let error: string | null = null;

if (!slug) {
  Astro.response.status = 404;
  error = "Template not found.";
} else {
  try {
    const config = getConfig(Astro.locals);
    const db = createDb(config.database.url);

    const results = await db
      .select({
        id: templates.id,
        slug: templates.slug,
        title: templates.title,
        description: templates.description,
        body: templates.body,
        issueTags: templates.issueTags,
        linkedBillNumbers: templates.linkedBillNumbers,
        isPublic: templates.isPublic,
        moderationStatus: templates.moderationStatus,
        viewCount: templates.viewCount,
        useCount: templates.useCount,
        userId: templates.userId,
        forkedFrom: templates.forkedFrom,
        createdAt: templates.createdAt,
      })
      .from(templates)
      .where(eq(templates.slug, slug))
      .limit(1);

    if (results.length > 0) {
      const foundTemplate = results[0];
      const isOwnerOfTemplate = user && foundTemplate.userId === user.id;
      const isPublicAndApproved =
        foundTemplate.isPublic && foundTemplate.moderationStatus === "approved";

      if (isPublicAndApproved || isOwnerOfTemplate) {
        template = foundTemplate;

        if (isPublicAndApproved) {
          await db
            .update(templates)
            .set({ viewCount: sql`${templates.viewCount} + 1` })
            .where(eq(templates.id, template.id));
        }
      } else {
        Astro.response.status = 404;
        error = "Template not found.";
      }
    } else {
      Astro.response.status = 404;
      error = "Template not found.";
    }
  } catch (e) {
    console.error("Failed to load template:", e);
    Astro.response.status = 500;
    error = "Failed to load template.";
  }
}

const isOwner = user && template?.userId === user.id;

function getCleanDescription(body: string): string {
  const templateVarPattern = /\{\{(\w+)\}\}/g;
  const cleaned = body.replace(templateVarPattern, "").trim();
  const truncated = cleaned.slice(0, 155);
  return truncated + (cleaned.length > 155 ? "..." : "");
}

const metaDescription = template
  ? (template.description ?? getCleanDescription(template.body))
  : "Template not found";
---

<Layout title={template ? template.title : "Template Not Found"} description={metaDescription}>
  <Header currentPath="/templates" user={user} />

  <main id="main-content" class="flex-1 py-12">
    <div class="container-page">
      {
        error ? (
          <div class="container-narrow text-center">
            <AstroCard variant="civicLg">
              <div class="icon-box-lg mx-auto mb-6">
                <svg
                  class="w-8 h-8 text-destructive"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  />
                </svg>
              </div>
              <h1 class="heading-card-lg">{error}</h1>
              <p class="text-muted-foreground mb-8">
                The template you're looking for couldn't be found or may have been removed.
              </p>
              <AstroButton href="/templates" variant="civic">
                Browse Templates
              </AstroButton>
            </AstroCard>
          </div>
        ) : (
          template && (
            <div class="container-wide">
              <div class="mb-6">
                <a
                  href={repBioguideId ? `/templates?rep=${repBioguideId}` : "/templates"}
                  class="link-back"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 19l-7-7 7-7"
                    />
                  </svg>
                  <span>Back to Templates</span>
                </a>
              </div>

              <AstroCard variant="civicLg" class="block">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6">
                  <h1
                    data-testid="template-title"
                    class="text-2xl md:text-3xl font-bold text-primary"
                  >
                    {template.title}
                  </h1>
                  <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <span>{template.viewCount.toLocaleString()} views</span>
                    <span>·</span>
                    <span>{template.useCount.toLocaleString()} uses</span>
                  </div>
                </div>

                {template.issueTags && template.issueTags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-6">
                    {template.issueTags.map((tag) => (
                      <span
                        data-testid="issue-tag"
                        class="px-3 py-1 text-sm bg-secondary text-muted-foreground rounded capitalize"
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                {template.linkedBillNumbers && template.linkedBillNumbers.length > 0 && (
                  <div class="mb-6" data-testid="linked-legislation">
                    <p class="text-sm font-medium text-muted-foreground mb-2">
                      Related Legislation
                    </p>
                    <div class="flex flex-wrap gap-2">
                      {template.linkedBillNumbers.map((bill) => (
                        <a
                          href={`/templates?bill=${encodeURIComponent(bill)}`}
                          class="px-3 py-1 text-sm bg-accent/10 text-accent border border-accent/20 rounded hover:bg-accent/20 transition-colors"
                          data-testid="linked-bill"
                        >
                          {bill}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <div class="mb-6">
                  <ShareButtons
                    client:load
                    url={Astro.url.href}
                    title={template.title}
                    description={metaDescription}
                    pageType="template"
                  />
                </div>

                <div class="mb-8">
                  <MarkdownContent
                    content={template.body}
                    className="text-foreground leading-relaxed"
                    data-testid="template-body"
                  />
                </div>

                <div class="flex flex-col gap-4 pt-6 border-t border-border">
                  {repBioguideId ? (
                    <div class="flex flex-col sm:flex-row gap-4">
                      <TemplateUseButton
                        client:load
                        href={`/rep/${repBioguideId}?template=${template.slug}`}
                        templateSlug={template.slug}
                        templateTitle={template.title}
                        repBioguideId={repBioguideId}
                      />
                      <AstroButton
                        href={`/rep/${repBioguideId}`}
                        variant="civicSecondary"
                        class="text-center"
                      >
                        Return Without Template
                      </AstroButton>
                    </div>
                  ) : (
                    <div class="space-y-4">
                      <TemplateUseButton
                        client:load
                        href={`/?template=${template.slug}`}
                        templateSlug={template.slug}
                        templateTitle={template.title}
                      />
                      <p class="text-sm text-muted-foreground">
                        You'll enter your ZIP code to find your representatives, then customize and
                        send your letter.
                      </p>
                    </div>
                  )}

                  <div class="flex flex-wrap gap-4 mt-4 pt-4 border-t border-border/50">
                    {user ? (
                      <AstroButton
                        href={`/templates/fork/${template.slug}`}
                        data-testid="fork-button"
                        variant="civicSecondary"
                        class="text-center"
                      >
                        Fork Template
                      </AstroButton>
                    ) : (
                      <AstroButton
                        type="button"
                        data-testid="fork-button-login"
                        variant="civicSecondary"
                        class="text-center opacity-75"
                        onclick="document.querySelector('[data-testid=sign-in-button]')?.click()"
                      >
                        Sign in to Fork
                      </AstroButton>
                    )}

                    <TemplateReportButton
                      client:load
                      templateSlug={template.slug}
                      variant="destructive"
                    />
                  </div>
                </div>

                {isOwner && (
                  <div class="mt-6 pt-6 border-t border-border">
                    <p class="text-sm text-muted-foreground mb-4">You created this template</p>
                    <div class="flex gap-4">
                      <AstroButton
                        href={`/templates/${template.slug}/edit`}
                        variant="civicSecondary"
                        size="sm"
                      >
                        Edit
                      </AstroButton>
                    </div>
                  </div>
                )}
              </AstroCard>

              {template.forkedFrom && (
                <p class="mt-4 text-sm text-muted-foreground text-center">
                  This template was forked from another template
                </p>
              )}
            </div>
          )
        )
      }
    </div>
  </main>

  <Footer currentPath="/templates" />
</Layout>
