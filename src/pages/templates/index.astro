---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageSection from "@/components/PageSection.astro";
import AstroButton from "@/components/ui/AstroButton.astro";
import AstroAlert from "@/components/ui/AstroAlert.astro";
import { TemplateSearch } from "@/components/TemplateSearch";
import { createDb } from "@/db/client";
import { legislators, bills } from "@/db/schema";
import { eq, and, desc } from "drizzle-orm";
import { getConfig } from "@/lib/config";
import { normalizeBillNumber, parseBillNumber } from "@/lib/bill-utils";

export const prerender = false;

const user = Astro.locals.user;
const rawRepId = Astro.url.searchParams.get("rep");
const repBioguideId = rawRepId && /^[A-Z]{1,2}\d{5,6}$/.test(rawRepId) ? rawRepId : null;
let repName: string | null = null;

const rawBillParam = Astro.url.searchParams.get("bill");
const billFilter = rawBillParam ? normalizeBillNumber(rawBillParam) : null;
let billTitle: string | null = null;

const config = getConfig(Astro.locals);
const db = createDb(config.database.url);

if (repBioguideId) {
  try {
    const [rep] = await db
      .select({ firstName: legislators.firstName, lastName: legislators.lastName })
      .from(legislators)
      .where(eq(legislators.bioguideId, repBioguideId))
      .limit(1);
    if (rep) {
      repName = `${rep.firstName} ${rep.lastName}`;
    }
  } catch (error) {
    console.error("Failed to load representative:", error);
  }
}

if (billFilter) {
  try {
    const parsed = parseBillNumber(billFilter);
    if (parsed) {
      const [bill] = await db
        .select({ title: bills.title })
        .from(bills)
        .where(and(eq(bills.billType, parsed.type), eq(bills.billNumber, String(parsed.number))))
        .orderBy(desc(bills.congress))
        .limit(1);
      if (bill) {
        billTitle = bill.title;
      }
    }
  } catch (error) {
    console.error("Failed to look up bill title:", error);
  }
}
---

<Layout
  title="Letter Templates"
  description="Browse community-contributed letter templates for contacting Congress on healthcare, environment, immigration, and more."
>
  <Header currentPath="/templates" user={user} />

  <main id="main-content" class="flex-1 py-12">
    <PageSection width="wide">
      {
        repBioguideId && repName && (
          <AstroAlert variant="info" class="mb-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <p class="text-sm text-primary">
                Choosing a template to contact <span class="font-semibold">{repName}</span>
              </p>
              <a
                href={`/rep/${repBioguideId}`}
                class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-accent transition-colors"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"
                  />
                </svg>
                Return without template
              </a>
            </div>
          </AstroAlert>
        )
      }

      <PageHeader
        title="Letter Templates"
        gradientWord="Templates"
        description="Browse community-contributed letter templates for common issues. Use them as a starting point or inspiration for your own message to Congress."
      >
        <AstroButton href="/templates/new">Create New Template</AstroButton>
      </PageHeader>

      <div data-testid="template-list">
        <TemplateSearch
          client:load
          repBioguideId={repBioguideId}
          billFilter={billFilter}
          billTitle={billTitle}
        />
      </div>
    </PageSection>
  </main>

  <Footer currentPath="/templates" />
</Layout>
