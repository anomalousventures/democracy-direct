---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import PageSection from "../components/PageSection.astro";
import AstroCard from "../components/ui/AstroCard.astro";
import Icon from "../components/icons/Icon.astro";

export const prerender = false;

const user = Astro.locals.user;
---

<Layout title="About" description="Learn about Democracy Direct and our mission.">
  <Header currentPath="/about" user={user} />

  <main id="main-content" class="flex-1 py-12">
    <PageSection>
      <PageHeader
        title="About Democracy Direct"
        gradientWord="Democracy Direct"
        description="Our mission: making civic engagement effortless, private, and accessible to everyone."
      />

      <AstroCard variant="civicLg" class="mb-8">
        <div class="icon-box mb-6">
          <Icon name="triangle-alert" class="w-7 h-7 text-accent" />
        </div>
        <h2 class="heading-card-lg">The Problem</h2>
        <p class="text-body">
          Contacting elected representatives is unnecessarily difficult. Finding who represents you
          requires navigating multiple government websites. Representatives don't publish email
          addresses. Most people don't know how to write an effective letter. Existing tools require
          accounts and track usage.
        </p>
      </AstroCard>

      <AstroCard variant="civicLg" class="mb-8">
        <div class="icon-box mb-6">
          <Icon name="lock" class="w-7 h-7 text-accent" />
        </div>
        <h2 class="heading-card-lg">Privacy First</h2>
        <p class="text-body">
          We believe civic participation should not require surveillance. We don't store your email
          address—when you log in, we hash it using SHA-256 and store only the hash. We don't log
          your ZIP code lookups. We never see your letters.
        </p>
      </AstroCard>

      <AstroCard variant="civicLg">
        <div class="icon-box mb-6">
          <Icon name="database" class="w-7 h-7 text-accent" />
        </div>
        <h2 class="heading-card-lg">Data Sources</h2>
        <p class="text-body mb-4">All representative data comes from public sources:</p>
        <ul class="space-y-3">
          <li class="list-item-bullet">
            <span class="list-bullet"></span>
            <span class="text-muted-foreground">
              <a
                href="https://github.com/unitedstates/congress-legislators"
                target="_blank"
                rel="noopener"
                class="text-primary hover:text-accent transition-colors underline underline-offset-2"
              >
                unitedstates/congress-legislators
              </a> — Legislator information
            </span>
          </li>
          <li class="list-item-bullet">
            <span class="list-bullet"></span>
            <span class="text-muted-foreground">Census Bureau — ZIP-to-district mapping</span>
          </li>
          <li class="list-item-bullet">
            <span class="list-bullet"></span>
            <span class="text-muted-foreground">Congress.gov — Voting records (coming soon)</span>
          </li>
        </ul>
        <p class="text-body mt-6">
          See our <a
            href="/roadmap"
            class="text-primary hover:text-accent transition-colors underline underline-offset-2"
            >roadmap</a
          > for planned features.
        </p>
      </AstroCard>
    </PageSection>

    <PageSection variant="cta" divider>
      <div class="text-center">
        <div class="icon-box-accent mb-8">
          <Icon name="message-circle" class="w-8 h-8 text-accent" />
        </div>

        <h2 class="heading-section text-primary-foreground mb-6">Get In Touch</h2>
        <p class="text-primary-foreground/80 text-lg leading-relaxed mb-8">
          Have questions or feedback? We'd love to hear from you. Open an issue on our GitHub
          repository or contribute to make civic engagement even better.
        </p>

        <a
          href="https://github.com/anomalousventures/democracy-direct"
          target="_blank"
          rel="noopener noreferrer"
          class="link-accent"
        >
          <Icon name="brand-github" class="w-5 h-5" />
          <span>View on GitHub</span>
          <Icon name="chevron-right" class="w-4 h-4" />
        </a>
      </div>
    </PageSection>
  </main>

  <Footer currentPath="/about" />
</Layout>
