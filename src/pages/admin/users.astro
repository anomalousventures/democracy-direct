---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AstroButton from "@/components/ui/AstroButton.astro";
import AstroBadge from "@/components/ui/AstroBadge.astro";
import { createDb } from "@/db/client";
import { users, templates } from "@/db/schema";
import { desc, count, inArray } from "drizzle-orm";
import { getConfig } from "@/lib/config";
import { isAdmin } from "@/lib/admin";
import { TRUST_LEVELS } from "@/lib/trust-level";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/?login=required");
}

if (!isAdmin(user)) {
  return new Response(null, { status: 403 });
}

type UserItem = {
  id: string;
  trustLevel: number;
  approvedTemplatesCount: number;
  createdAt: Date;
  templateCount: number;
};

let userItems: UserItem[] = [];

try {
  const config = getConfig(Astro.locals);
  const db = createDb(config.database.url);

  const userRows = await db
    .select({
      id: users.id,
      trustLevel: users.trustLevel,
      approvedTemplatesCount: users.approvedTemplatesCount,
      createdAt: users.createdAt,
    })
    .from(users)
    .orderBy(desc(users.createdAt))
    .limit(100);

  const userIds = userRows.map((u) => u.id);
  let countMap = new Map<string, number>();

  if (userIds.length > 0) {
    const templateCounts = await db
      .select({
        userId: templates.userId,
        count: count(),
      })
      .from(templates)
      .where(inArray(templates.userId, userIds))
      .groupBy(templates.userId);

    countMap = new Map(
      templateCounts
        .filter((tc): tc is { userId: string; count: number } => tc.userId !== null)
        .map((tc) => [tc.userId, tc.count])
    );
  }

  userItems = userRows.map((u) => ({
    ...u,
    templateCount: countMap.get(u.id) ?? 0,
  }));
} catch (error) {
  console.error("Failed to load users:", error);
}

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

type BadgeVariant = "destructive" | "secondary" | "default" | "outline" | "success" | "warning";

function getTrustLevelBadge(level: number): { label: string; variant: BadgeVariant } {
  const badges: Record<number, { label: string; variant: BadgeVariant }> = {
    [TRUST_LEVELS.BANNED]: { label: "Banned", variant: "destructive" },
    [TRUST_LEVELS.NEW_USER]: { label: "New User", variant: "secondary" },
    [TRUST_LEVELS.TRUSTED]: { label: "Trusted", variant: "default" },
    [TRUST_LEVELS.ADMIN]: { label: "Admin", variant: "outline" },
  };
  return badges[level] ?? { label: `Level ${level}`, variant: "secondary" };
}

function truncateId(id: string): string {
  if (id.length <= 12) return id;
  return id.slice(0, 6) + "..." + id.slice(-4);
}
---

<Layout title="User Management">
  <Header currentPath="/admin" user={user} />

  <main id="main-content" class="flex-1 py-12">
    <div class="container-page">
      <div class="container-xl">
        <div class="flex-between mb-8">
          <div>
            <h1 class="text-2xl md:text-3xl font-bold text-primary">User Management</h1>
            <p class="text-muted-foreground mt-1">{userItems.length} users</p>
          </div>
          <AstroButton href="/admin" variant="secondary">Back to Dashboard</AstroButton>
        </div>

        <div class="mb-6">
          <label for="user-search" class="sr-only">Search users by ID</label>
          <input
            type="text"
            id="user-search"
            placeholder="Search by user ID..."
            class="w-full max-w-md px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
          />
        </div>

        <div
          data-testid="user-list"
          class="relative w-full overflow-auto rounded-lg border border-border"
        >
          <table class="w-full caption-bottom text-sm">
            <thead class="[&_tr]:border-b">
              <tr class="border-b transition-colors hover:bg-muted/50">
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground"
                  >User ID</th
                >
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground"
                  >Trust Level</th
                >
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground"
                  >Templates</th
                >
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground"
                  >Approved</th
                >
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground"
                  >Joined</th
                >
                <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground"
                  >Actions</th
                >
              </tr>
            </thead>
            <tbody class="[&_tr:last-child]:border-0" id="user-tbody">
              {
                userItems.map((u) => {
                  const trust = getTrustLevelBadge(u.trustLevel);
                  return (
                    <tr
                      data-testid="user-row"
                      data-user-id={u.id}
                      class="border-b transition-colors hover:bg-muted/50"
                    >
                      <td class="p-4 align-middle font-mono text-sm" title={u.id}>
                        {truncateId(u.id)}
                      </td>
                      <td class="p-4 align-middle">
                        <AstroBadge variant={trust.variant} data-testid="trust-badge">
                          {trust.label}
                        </AstroBadge>
                      </td>
                      <td class="p-4 align-middle">{u.templateCount}</td>
                      <td class="p-4 align-middle">{u.approvedTemplatesCount}</td>
                      <td class="p-4 align-middle text-muted-foreground">
                        {formatDate(u.createdAt)}
                      </td>
                      <td class="p-4 align-middle">
                        <select
                          class="h-9 rounded-md border border-input bg-background px-3 py-1 text-sm ring-offset-background focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 trust-select"
                          data-testid="trust-select"
                          aria-label={`Change trust level for user ${truncateId(u.id)}`}
                        >
                          <option
                            value={TRUST_LEVELS.BANNED}
                            selected={u.trustLevel === TRUST_LEVELS.BANNED}
                          >
                            Banned
                          </option>
                          <option
                            value={TRUST_LEVELS.NEW_USER}
                            selected={u.trustLevel === TRUST_LEVELS.NEW_USER}
                          >
                            New User
                          </option>
                          <option
                            value={TRUST_LEVELS.TRUSTED}
                            selected={u.trustLevel === TRUST_LEVELS.TRUSTED}
                          >
                            Trusted
                          </option>
                          <option
                            value={TRUST_LEVELS.ADMIN}
                            selected={u.trustLevel === TRUST_LEVELS.ADMIN}
                          >
                            Admin
                          </option>
                        </select>
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>

        {
          userItems.length === 0 && (
            <div class="text-center py-12">
              <p class="text-muted-foreground">No users found.</p>
            </div>
          )
        }
      </div>
    </div>
  </main>

  <Footer currentPath="/admin" />
</Layout>

<script is:inline>
  document.getElementById("user-search")?.addEventListener("input", function (e) {
    const search = e.target.value.toLowerCase();
    document.querySelectorAll('[data-testid="user-row"]').forEach((row) => {
      const userId = row.getAttribute("data-user-id")?.toLowerCase() ?? "";
      row.style.display = userId.includes(search) ? "" : "none";
    });
  });

  document.addEventListener("change", async function (e) {
    const select = e.target.closest(".trust-select");
    if (!select) return;

    const row = select.closest("[data-user-id]");
    if (!row) return;

    const userId = row.getAttribute("data-user-id");
    const newLevel = select.value;
    if (!userId) return;

    try {
      const response = await fetch(`/api/admin/users/${encodeURIComponent(userId)}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ trustLevel: parseInt(newLevel, 10) }),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.error || "Failed to update trust level");
        window.location.reload();
      }
    } catch {
      alert("Failed to update trust level");
      window.location.reload();
    }
  });
</script>
