---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AstroButton from "@/components/ui/AstroButton.astro";
import AstroBadge from "@/components/ui/AstroBadge.astro";
import AstroCard from "@/components/ui/AstroCard.astro";
import { ModerationToast } from "@/components/ModerationToast";
import { ModerationScoresPanel } from "@/components/ModerationScoresPanel";
import { ExpandableContent } from "@/components/ExpandableContent";
import { createDb } from "@/db/client";
import { templates } from "@/db/schema";
import { eq, or, desc } from "drizzle-orm";
import { getConfig } from "@/lib/config";
import { isAdmin } from "@/lib/admin";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/?login=required");
}

if (!isAdmin(user)) {
  return new Response(null, { status: 403 });
}

type QueueItem = {
  id: string;
  slug: string;
  title: string;
  body: string;
  moderationStatus: string;
  moderationScores: Record<string, number> | null;
  flagCount: number;
  createdAt: Date;
  userId: string | null;
};

let queueItems: QueueItem[] = [];

try {
  const config = getConfig(Astro.locals);
  const db = createDb(config.database.url);

  queueItems = await db
    .select({
      id: templates.id,
      slug: templates.slug,
      title: templates.title,
      body: templates.body,
      moderationStatus: templates.moderationStatus,
      moderationScores: templates.moderationScores,
      flagCount: templates.flagCount,
      createdAt: templates.createdAt,
      userId: templates.userId,
    })
    .from(templates)
    .where(or(eq(templates.moderationStatus, "pending"), eq(templates.moderationStatus, "flagged")))
    .orderBy(desc(templates.flagCount), desc(templates.createdAt))
    .limit(50);
} catch (error) {
  console.error("Failed to load moderation queue:", error);
}

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

type BadgeVariant = "destructive" | "secondary" | "default" | "outline" | "success" | "warning";

function getStatusBadge(status: string): { label: string; variant: BadgeVariant } {
  const badges: Record<string, { label: string; variant: BadgeVariant }> = {
    pending: { label: "Pending Review", variant: "warning" },
    flagged: { label: "Flagged", variant: "destructive" },
  };
  return badges[status] ?? { label: status, variant: "secondary" };
}
---

<Layout title="Moderation Queue">
  <ModerationToast client:load />
  <Header currentPath="/admin" user={user} />

  <main id="main-content" class="flex-1 py-12">
    <div class="container-page">
      <div class="container-xl">
        <div class="flex-between mb-8">
          <div>
            <h1 class="text-2xl md:text-3xl font-bold text-primary">Moderation Queue</h1>
            <p class="text-muted-foreground mt-1">
              {queueItems.length} items awaiting review
            </p>
          </div>
          <AstroButton href="/admin" variant="secondary">Back to Dashboard</AstroButton>
        </div>

        <div data-testid="queue-items" class="space-y-6">
          {
            queueItems.length > 0 ? (
              queueItems.map((item) => {
                const status = getStatusBadge(item.moderationStatus);
                return (
                  <AstroCard variant="civic" data-testid="queue-item" data-template-id={item.id}>
                    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 mb-4">
                      <div class="flex-1">
                        <div class="flex items-center gap-3 mb-2">
                          <h2 class="text-xl font-semibold text-primary">{item.title}</h2>
                          <AstroBadge variant={status.variant}>{status.label}</AstroBadge>
                          {item.flagCount > 0 && (
                            <AstroBadge variant="destructive">{item.flagCount} flags</AstroBadge>
                          )}
                        </div>
                        <ExpandableContent
                          client:load
                          content={item.body}
                          className="text-muted-foreground"
                        />
                      </div>
                    </div>

                    <ModerationScoresPanel
                      client:load
                      templateId={item.id}
                      initialScores={item.moderationScores}
                    />

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-4 border-t border-border">
                      <div class="text-sm text-muted-foreground">
                        Created {formatDate(item.createdAt)}
                      </div>
                      <div class="flex gap-2">
                        <AstroButton
                          variant="success"
                          size="sm"
                          class="moderation-btn"
                          data-testid="approve-button"
                          data-action="approve"
                        >
                          Approve
                        </AstroButton>
                        <AstroButton
                          variant="destructive"
                          size="sm"
                          class="moderation-btn"
                          data-testid="reject-button"
                          data-action="reject"
                        >
                          Reject
                        </AstroButton>
                      </div>
                    </div>
                  </AstroCard>
                );
              })
            ) : (
              <div class="text-center py-12">
                <div class="w-16 h-16 mx-auto mb-6 bg-green-100 flex items-center justify-center rounded-full">
                  <svg
                    class="w-8 h-8 text-green-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </div>
                <p class="text-muted-foreground">All caught up! No items pending review.</p>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </main>

  <Footer currentPath="/admin" />
</Layout>

<script is:inline>
  function showToast(type, message) {
    window.dispatchEvent(
      new CustomEvent("moderation-toast", {
        detail: { type, message },
      })
    );
  }

  document.addEventListener("click", async function (e) {
    const moderationBtn = e.target.closest(".moderation-btn");

    if (!moderationBtn) return;

    const article = moderationBtn.closest("[data-template-id]");
    if (!article) return;

    const templateId = article.getAttribute("data-template-id");
    const action = moderationBtn.getAttribute("data-action");
    if (!templateId || !action) return;

    const reason = action === "reject" ? prompt("Reason for rejection (optional):") : null;

    try {
      const response = await fetch(`/api/admin/moderate/${encodeURIComponent(templateId)}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action, reason }),
      });

      if (response.ok) {
        article.remove();
        const countEl = document.querySelector('[data-testid="queue-items"]');
        const remaining = countEl?.querySelectorAll('[data-testid="queue-item"]').length ?? 0;
        const headerP = document.querySelector("main h1 + p");
        if (headerP) {
          headerP.textContent = `${remaining} items awaiting review`;
        }
        const pastTense = action === "approve" ? "approved" : "rejected";
        showToast("success", `Template ${pastTense} successfully`);
      } else {
        const data = await response.json();
        showToast("error", data.error || `Failed to ${action} template`);
      }
    } catch {
      showToast("error", `Failed to ${action} template`);
    }
  });
</script>
