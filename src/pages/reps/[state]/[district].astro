---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageSection from "@/components/PageSection.astro";
import AstroCard from "@/components/ui/AstroCard.astro";
import AstroButton from "@/components/ui/AstroButton.astro";
import { createDb } from "@/db/client";
import { getLegislatorsByStateAndDistrict } from "@/db/queries/legislators";
import type { Legislator } from "@/db/schema";
import {
  getPhotoUrl,
  getPartyColor,
  getPartyLabel,
  getRepTitle,
  formatDate,
} from "@/lib/legislator-utils";
import { getConfig } from "@/lib/config";
import { getStateName, isValidState } from "@/lib/states";
import { SaveDistrictPrompt } from "@/components/SaveDistrictPrompt";

const user = Astro.locals.user;

const { state: rawState, district: rawDistrict } = Astro.params;
const state = rawState?.toUpperCase() ?? "";
const district = rawDistrict?.toUpperCase() ?? "";

const rawTemplateSlug = Astro.url.searchParams.get("template");
const templateSlug =
  rawTemplateSlug && /^[a-z0-9-]{1,100}$/.test(rawTemplateSlug) ? rawTemplateSlug : null;
const templateQueryParam = templateSlug ? `?template=${encodeURIComponent(templateSlug)}` : "";

let reps: Legislator[] = [];
let error: string | null = null;

const isValidStateCode = isValidState(state);
const isValidDistrict = /^(\d{1,2}|AL|0)$/.test(district);

if (!isValidStateCode) {
  Astro.response.status = 404;
  error = "Invalid state code.";
} else if (!isValidDistrict) {
  Astro.response.status = 404;
  error = "Invalid district.";
} else {
  const config = getConfig(Astro.locals);
  const db = createDb(config.database.url);

  const normalizedDistrict = district === "AL" ? "0" : district;

  const [loadedReps, dbError] = await getLegislatorsByStateAndDistrict(
    db,
    state,
    normalizedDistrict
  )
    .then((result) => [result, null] as const)
    .catch((e) => {
      console.error("Database error:", e);
      return [[] as Legislator[], "Failed to look up representatives. Please try again."] as const;
    });

  reps = loadedReps.sort((a, b) => {
    if (a.chamber === "house" && b.chamber === "senate") return -1;
    if (a.chamber === "senate" && b.chamber === "house") return 1;
    return 0;
  });
  error = dbError;

  if (!error && reps.length === 0) {
    Astro.response.status = 404;
    error = "No representatives found for this district.";
  }
}

const stateName = isValidStateCode ? getStateName(state) : state;
const districtDisplay = district === "0" || district === "AL" ? "At-Large" : `District ${district}`;
---

<Layout
  title={!error ? `Representatives for ${state}-${district} | ${stateName}` : "District Not Found"}
  description={!error
    ? `Find and contact your ${reps.length} elected officials for ${stateName} ${districtDisplay}`
    : "District not found"}
>
  <Header currentPath={`/reps/${state.toLowerCase()}/${district.toLowerCase()}`} user={user} />

  <main id="main-content" class="flex-1 py-12">
    {
      error ? (
        <div class="container-page">
          <div class="container-narrow text-center">
            <AstroCard variant="civicLg">
              <div class="icon-box-lg mx-auto mb-6">
                <svg
                  class="w-8 h-8 text-destructive"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  />
                </svg>
              </div>
              <h1 class="heading-card-lg">{error}</h1>
              <p class="text-muted-foreground mb-8">Please check the district and try again.</p>
              <AstroButton href="/" variant="civic">
                Look Up By ZIP Code
              </AstroButton>
            </AstroCard>
          </div>
        </div>
      ) : (
        <PageSection width="wide">
          <PageHeader
            title="Your Representatives"
            gradientWord="Representatives"
            description={`Your elected officials for ${stateName}'s ${districtDisplay}`}
          />

          <div class="mb-8">
            <SaveDistrictPrompt state={state} district={district} client:load />
          </div>

          <div class="grid gap-6">
            {reps.map((rep, index) => (
              <a
                href={`/rep/${rep.bioguideId}${templateQueryParam}`}
                class="block group animate-fade-up"
                style={`animation-delay: ${index * 100}ms`}
              >
                <AstroCard
                  variant="civic"
                  class="group-hover:-translate-y-1 group-hover:shadow-civic-lg transition-all duration-300"
                >
                  <div class="flex flex-col sm:flex-row gap-6">
                    <div class="flex-shrink-0">
                      <div class="rep-photo-sm">
                        <img
                          src={getPhotoUrl(rep.bioguideId)}
                          alt={`${rep.firstName} ${rep.lastName}`}
                          class="w-full h-full object-cover object-top"
                          loading="lazy"
                          onerror="this.style.display='none'"
                        />
                        <div class="rep-photo-fallback-sm" style="font-family: var(--font-display)">
                          {rep.firstName[0]}
                          {rep.lastName[0]}
                        </div>
                      </div>
                    </div>

                    <div class="flex-1 min-w-0">
                      <div class="flex items-start justify-between gap-4 mb-2">
                        <div>
                          <h2 class="text-xl sm:text-2xl font-bold group-hover:text-accent transition-colors">
                            {rep.firstName} {rep.lastName}
                          </h2>
                          <p class="text-muted-foreground">
                            {getRepTitle(rep.chamber, rep.state, rep.district, "short")}
                          </p>
                        </div>
                        <span class={`${getPartyColor(rep.party)} party-badge`}>
                          {getPartyLabel(rep.party, true)}
                        </span>
                      </div>

                      {rep.termStart && (
                        <p class="text-sm text-muted-foreground mb-3">
                          <span class="font-medium">Term:</span> {formatDate(rep.termStart)}
                          {rep.termEnd && ` — ${formatDate(rep.termEnd)}`}
                        </p>
                      )}

                      <div class="flex flex-wrap items-center gap-3">
                        {rep.website && (
                          <span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground">
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                              />
                            </svg>
                            <span class="truncate max-w-[150px]">
                              {new URL(rep.website).hostname.replace("www.", "")}
                            </span>
                          </span>
                        )}

                        {rep.twitterHandle && (
                          <span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                            </svg>
                            <span>@{rep.twitterHandle}</span>
                          </span>
                        )}

                        {rep.facebookId && (
                          <span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                            </svg>
                            <span>Facebook</span>
                          </span>
                        )}
                      </div>

                      <div class="mt-4 pt-4 border-t border-border/50 flex items-center justify-between">
                        <span class="text-sm font-medium text-primary group-hover:text-accent transition-colors flex items-center gap-2">
                          View Details
                          <svg
                            class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M9 5l7 7-7 7"
                            />
                          </svg>
                        </span>
                      </div>
                    </div>
                  </div>
                </AstroCard>
              </a>
            ))}
          </div>

          <div class="text-center mt-12">
            <a href="/" class="link-back">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                />
              </svg>
              <span>Look up a different district</span>
            </a>
          </div>
        </PageSection>
      )
    }
  </main>

  <Footer currentPath={`/reps/${state.toLowerCase()}/${district.toLowerCase()}`} />
</Layout>
