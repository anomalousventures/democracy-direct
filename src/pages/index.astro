---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <main class="container mx-auto px-4 py-8 flex-1">
    <section data-testid="hero" class="text-center py-16 md:py-24">
      <h1 class="text-4xl md:text-6xl font-bold mb-4">Democracy Direct</h1>
      <p class="text-xl md:text-2xl text-muted-foreground mb-8">
        Direct access to your democracy.
      </p>

      <div class="max-w-md mx-auto">
        <form class="flex flex-col sm:flex-row gap-3" action="/zip" method="get">
          <div class="flex-1">
            <label for="zip-input" class="sr-only">Enter your ZIP code</label>
            <input
              id="zip-input"
              name="zip"
              type="text"
              inputmode="numeric"
              pattern="[0-9]{5}"
              maxlength="5"
              placeholder="Enter your ZIP code"
              aria-label="ZIP code"
              class="w-full px-4 py-3 rounded-md border border-input bg-background text-lg focus:outline-none focus:ring-2 focus:ring-ring"
              required
            />
          </div>
          <button
            type="submit"
            class="px-6 py-3 bg-primary text-primary-foreground rounded-md font-medium hover:bg-primary/90 transition-colors"
          >
            Find My Reps
          </button>
        </form>
      </div>
    </section>

    <section class="max-w-3xl mx-auto py-12 text-center">
      <h2 class="text-2xl font-semibold mb-6">How It Works</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-6">
          <div class="text-4xl mb-4">📍</div>
          <h3 class="font-semibold mb-2">Enter Your ZIP</h3>
          <p class="text-muted-foreground">
            We find your senators and representative based on your location.
          </p>
        </div>
        <div class="p-6">
          <div class="text-4xl mb-4">📝</div>
          <h3 class="font-semibold mb-2">Choose a Template</h3>
          <p class="text-muted-foreground">
            Pick from community-contributed letter templates or write your own.
          </p>
        </div>
        <div class="p-6">
          <div class="text-4xl mb-4">📤</div>
          <h3 class="font-semibold mb-2">Contact Congress</h3>
          <p class="text-muted-foreground">
            Copy your letter and paste it into your rep's contact form.
          </p>
        </div>
      </div>
    </section>

    <section class="max-w-2xl mx-auto py-12 text-center">
      <h2 class="text-2xl font-semibold mb-4">Privacy First</h2>
      <p class="text-muted-foreground">
        We don't store your email address, ZIP code lookups, or letters. Your civic
        participation stays private.
      </p>
    </section>
  </main>

  <footer class="border-t border-border py-8">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-muted-foreground text-sm">
          © {new Date().getFullYear()} Democracy Direct
        </p>
        <nav class="flex gap-6">
          <a href="/about" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            About
          </a>
          <a href="/privacy" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Privacy
          </a>
          <a href="/templates" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            Templates
          </a>
        </nav>
      </div>
    </div>
  </footer>
</Layout>
