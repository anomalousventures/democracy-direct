---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ZipLookup } from "../components/ZipLookup";

export const prerender = false;

const user = Astro.locals.user;
const templateSlug = Astro.url.searchParams.get("template") || undefined;
const ambiguousZip = Astro.url.searchParams.get("ambiguous") || undefined;
---

<Layout
  title="Your Voice, Your Representatives"
  description="Find and contact your elected officials with privacy-first letter templates. No account required. No data harvested."
>
  <Header currentPath="/" user={user} />

  <main id="main-content" class="flex-1">
    <section data-testid="hero" class="relative py-20 md:py-32 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div
          class="absolute top-0 left-1/4 w-96 h-96 bg-[var(--color-civic-navy)]/5 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-0 right-1/4 w-96 h-96 bg-[var(--color-civic-gold)]/10 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div class="container mx-auto px-4 relative">
        <div class="max-w-3xl mx-auto text-center">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-secondary)] border border-[var(--color-border)] text-sm text-[var(--color-muted-foreground)] mb-8 animate-fade-up"
          >
            <span class="w-2 h-2 rounded-full bg-[var(--color-civic-gold)]"></span>
            <span>Free • Private • Non-partisan</span>
          </div>

          <h1
            class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight animate-fade-up-delay-1"
          >
            Your Voice,<br />
            <span class="text-gradient">Your Representatives</span>
          </h1>

          <p
            class="text-lg md:text-xl text-muted-foreground max-w-xl mx-auto mb-12 animate-fade-up-delay-2"
          >
            Connect directly with your senators and representative. Enter your ZIP code to find who
            represents you in Congress.
          </p>

          <div class="animate-fade-up-delay-3">
            <ZipLookup client:load templateSlug={templateSlug} initialZip={ambiguousZip} />
          </div>
        </div>
      </div>
    </section>

    <div class="divider-civic"></div>

    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">How It Works</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto">
            Democracy shouldn't require a civics degree. We make it simple to find and contact your
            elected officials.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="card-civic group hover:-translate-y-1 transition-transform duration-300">
            <div
              class="w-14 h-14 bg-[var(--color-civic-navy)] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-7 h-7 text-[var(--color-civic-gold)]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">Enter Your ZIP</h3>
            <p class="text-muted-foreground leading-relaxed">
              Your ZIP code determines your congressional district. We instantly match you with your
              two senators and one representative.
            </p>
          </div>

          <div class="card-civic group hover:-translate-y-1 transition-transform duration-300">
            <div
              class="w-14 h-14 bg-[var(--color-civic-navy)] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-7 h-7 text-[var(--color-civic-gold)]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">Choose a Template</h3>
            <p class="text-muted-foreground leading-relaxed">
              Browse community-contributed letter templates for common issues, or write your own
              personalized message from scratch.
            </p>
          </div>

          <div class="card-civic group hover:-translate-y-1 transition-transform duration-300">
            <div
              class="w-14 h-14 bg-[var(--color-civic-navy)] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-7 h-7 text-[var(--color-civic-gold)]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">Make Contact</h3>
            <p class="text-muted-foreground leading-relaxed">
              Copy your message directly to their contact form, call their office, or print a letter
              to mail. Your choice.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-16 md:py-24 bg-[var(--color-civic-navy)] text-[var(--color-civic-cream)] relative overflow-hidden"
    >
      <div class="absolute inset-0 opacity-10" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"></path>
          </pattern>
          <rect width="100" height="100" fill="url(#grid)"></rect>
        </svg>
      </div>

      <div class="container mx-auto px-4 relative">
        <div class="max-w-3xl mx-auto text-center">
          <div
            class="inline-flex items-center justify-center w-16 h-16 bg-[var(--color-civic-gold)]/20 mb-8"
          >
            <svg
              class="w-8 h-8 text-[var(--color-civic-gold)]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
          </div>

          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-[var(--color-civic-cream)]">
            Privacy by Design
          </h2>
          <p class="text-[var(--color-civic-cream)]/80 text-lg leading-relaxed mb-8">
            We believe civic participation shouldn't require surveillance. Your ZIP code lookups,
            letters, and personal information are never stored on our servers. Everything happens in
            your browser.
          </p>

          <a
            href="/privacy"
            class="inline-flex items-center gap-2 text-[var(--color-civic-gold)] hover:text-[var(--color-civic-gold)]/80 transition-colors font-medium"
          >
            <span>Read our privacy policy</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer currentPath="/" />
</Layout>
