---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageSection from "../components/PageSection.astro";
import AstroCard from "../components/ui/AstroCard.astro";
import { ZipLookup } from "../components/ZipLookup";
import Icon from "../components/icons/Icon.astro";

export const prerender = false;

const user = Astro.locals.user;
const templateSlug = Astro.url.searchParams.get("template") || undefined;
const ambiguousZip = Astro.url.searchParams.get("ambiguous") || undefined;
---

<Layout
  title="Your Voice, Your Representatives"
  description="Find and contact your elected officials with privacy-first letter templates. No account required. No data harvested."
>
  <Header currentPath="/" user={user} />

  <main id="main-content" class="flex-1">
    <section data-testid="hero" class="section-hero">
      <div class="backdrop-container" aria-hidden="true">
        <div class="backdrop-blob-primary top-0 left-1/4"></div>
        <div class="backdrop-blob-accent bottom-0 right-1/4"></div>
      </div>

      <div class="container-page relative">
        <div class="container-medium text-center">
          <h1 class="heading-page lg:text-7xl animate-fade-up">
            Your Voice,<br />
            <span class="text-gradient">Your Representatives</span>
          </h1>

          <p
            class="text-lg md:text-xl text-muted-foreground max-w-xl mx-auto mb-12 animate-fade-up-delay-1"
          >
            Connect directly with your senators and representative. Enter your ZIP code to find who
            represents you in Congress.
          </p>

          <div class="animate-fade-up-delay-2">
            <ZipLookup client:load templateSlug={templateSlug} initialZip={ambiguousZip} />
          </div>
        </div>
      </div>
    </section>

    <div class="divider-civic"></div>

    <PageSection variant="default" width="xl">
      <div class="text-center mb-16">
        <h2 class="heading-section">How It Works</h2>
        <p class="text-body container-narrow mx-auto">
          Democracy shouldn't require a civics degree. We make it simple to find and contact your
          elected officials.
        </p>
      </div>

      <div class="grid-features">
        <AstroCard variant="civic">
          <div class="icon-box mb-6">
            <Icon name="map-pin" class="w-7 h-7 text-accent" />
          </div>
          <h3 class="heading-card">Enter Your ZIP</h3>
          <p class="text-body">
            Your ZIP code determines your congressional district. We instantly match you with your
            two senators and one representative.
          </p>
        </AstroCard>

        <AstroCard variant="civic">
          <div class="icon-box mb-6">
            <Icon name="file-text" class="w-7 h-7 text-accent" />
          </div>
          <h3 class="heading-card">Choose a Template</h3>
          <p class="text-body">
            Browse community-contributed letter templates for common issues, or write your own
            personalized message from scratch.
          </p>
        </AstroCard>

        <AstroCard variant="civic">
          <div class="icon-box mb-6">
            <Icon name="mail" class="w-7 h-7 text-accent" />
          </div>
          <h3 class="heading-card">Make Contact</h3>
          <p class="text-body">
            Copy your message directly to their contact form, call their office, or print a letter
            to mail. Your choice.
          </p>
        </AstroCard>
      </div>
    </PageSection>

    <PageSection variant="cta" width="medium">
      <div class="text-center">
        <div class="icon-box-accent mb-8">
          <Icon name="lock" class="w-8 h-8 text-accent" />
        </div>

        <h2 class="heading-section text-primary-foreground mb-6">Privacy by Design</h2>
        <p class="text-primary-foreground/80 text-lg leading-relaxed mb-8">
          We believe civic participation shouldn't require surveillance. Your ZIP code lookups,
          letters, and personal information are never stored on our servers. Everything happens in
          your browser.
        </p>

        <a href="/privacy" class="link-accent">
          <span>Read our privacy policy</span>
          <Icon name="chevron-right" class="w-4 h-4" />
        </a>
      </div>
    </PageSection>
  </main>

  <Footer currentPath="/" />
</Layout>
