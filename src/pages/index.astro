---
import Layout from "../layouts/Layout.astro";
import { ZipLookup } from "../components/ZipLookup";
---

<Layout title="Home">
  <header class="border-b border-border bg-white/80 backdrop-blur-sm sticky top-0 z-50">
    <div class="container mx-auto px-4 py-4">
      <nav class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 bg-[var(--color-civic-navy)] flex items-center justify-center">
            <span
              class="text-[var(--color-civic-gold)] text-xl font-bold"
              style="font-family: var(--font-display)">D</span
            >
          </div>
          <span class="font-semibold text-[var(--color-civic-navy)] hidden sm:inline"
            >Democracy Direct</span
          >
        </a>
        <div class="flex items-center gap-6">
          <a
            href="/about"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            About
          </a>
          <a
            href="/templates"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            Templates
          </a>
        </div>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <section data-testid="hero" class="relative py-20 md:py-32 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div
          class="absolute top-0 left-1/4 w-96 h-96 bg-[var(--color-civic-navy)]/5 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-0 right-1/4 w-96 h-96 bg-[var(--color-civic-gold)]/10 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div class="container mx-auto px-4 relative">
        <div class="max-w-3xl mx-auto text-center">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-secondary)] border border-[var(--color-border)] text-sm text-[var(--color-muted-foreground)] mb-8 animate-fade-up"
          >
            <span class="w-2 h-2 rounded-full bg-[var(--color-civic-gold)]"></span>
            <span>Free • Private • Non-partisan</span>
          </div>

          <h1
            class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight animate-fade-up-delay-1"
          >
            Your Voice,<br />
            <span class="text-gradient">Your Representatives</span>
          </h1>

          <p
            class="text-lg md:text-xl text-muted-foreground max-w-xl mx-auto mb-12 animate-fade-up-delay-2"
          >
            Connect directly with your senators and representative. Enter your ZIP code to find who
            represents you in Congress.
          </p>

          <div class="animate-fade-up-delay-3">
            <ZipLookup client:load />
          </div>
        </div>
      </div>
    </section>

    <div class="divider-civic"></div>

    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">How It Works</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto">
            Democracy shouldn't require a civics degree. We make it simple to find and contact your
            elected officials.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="card-civic group hover:-translate-y-1 transition-transform duration-300">
            <div
              class="w-14 h-14 bg-[var(--color-civic-navy)] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-7 h-7 text-[var(--color-civic-gold)]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">Enter Your ZIP</h3>
            <p class="text-muted-foreground leading-relaxed">
              Your ZIP code determines your congressional district. We instantly match you with your
              two senators and one representative.
            </p>
          </div>

          <div class="card-civic group hover:-translate-y-1 transition-transform duration-300">
            <div
              class="w-14 h-14 bg-[var(--color-civic-navy)] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-7 h-7 text-[var(--color-civic-gold)]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">Choose a Template</h3>
            <p class="text-muted-foreground leading-relaxed">
              Browse community-contributed letter templates for common issues, or write your own
              personalized message from scratch.
            </p>
          </div>

          <div class="card-civic group hover:-translate-y-1 transition-transform duration-300">
            <div
              class="w-14 h-14 bg-[var(--color-civic-navy)] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-7 h-7 text-[var(--color-civic-gold)]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">Make Contact</h3>
            <p class="text-muted-foreground leading-relaxed">
              Copy your message directly to their contact form, call their office, or print a letter
              to mail. Your choice.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-16 md:py-24 bg-[var(--color-civic-navy)] text-[var(--color-civic-cream)] relative overflow-hidden"
    >
      <div class="absolute inset-0 opacity-10" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"></path>
          </pattern>
          <rect width="100" height="100" fill="url(#grid)"></rect>
        </svg>
      </div>

      <div class="container mx-auto px-4 relative">
        <div class="max-w-3xl mx-auto text-center">
          <div
            class="inline-flex items-center justify-center w-16 h-16 bg-[var(--color-civic-gold)]/20 mb-8"
          >
            <svg
              class="w-8 h-8 text-[var(--color-civic-gold)]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
          </div>

          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-[var(--color-civic-cream)]">
            Privacy by Design
          </h2>
          <p class="text-[var(--color-civic-cream)]/80 text-lg leading-relaxed mb-8">
            We believe civic participation shouldn't require surveillance. Your ZIP code lookups,
            letters, and personal information are never stored on our servers. Everything happens in
            your browser.
          </p>

          <a
            href="/privacy"
            class="inline-flex items-center gap-2 text-[var(--color-civic-gold)] hover:text-[var(--color-civic-gold)]/80 transition-colors font-medium"
          >
            <span>Read our privacy policy</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-border py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-[var(--color-civic-navy)] flex items-center justify-center">
            <span
              class="text-[var(--color-civic-gold)] text-sm font-bold"
              style="font-family: var(--font-display)">D</span
            >
          </div>
          <span class="text-muted-foreground text-sm">
            © {new Date().getFullYear()} Democracy Direct
          </span>
        </div>

        <nav class="flex items-center gap-8">
          <a
            href="/about"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            About
          </a>
          <a
            href="/privacy"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            Privacy
          </a>
          <a
            href="/templates"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors"
          >
            Templates
          </a>
          <a
            href="https://github.com/anomalousventures/democracy-direct"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-muted-foreground hover:text-[var(--color-civic-navy)] transition-colors flex items-center gap-1"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
        </nav>
      </div>
    </div>
  </footer>
</Layout>
